---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import Nav from '../components/Nav.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title?: string;
  description?: string;
  current?: 'about' | 'gallery' | 'contact';
  intro?: boolean;
}

const {
  title = 'Jonas C. Morgner',
  description = 'Paintings on tension \u2014 weight and air, structure and rupture. Berlin.',
  current,
  intro = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1ec" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    {
      intro && (
        <div class="intro" id="intro" aria-hidden="true">
          <img src="/intro/00.png" alt="" class="intro__img is-active" />
          <img src="/intro/0.png" alt="" class="intro__img" />
          <img src="/intro/1.png" alt="" class="intro__img" />
          <img src="/intro/2.png" alt="" class="intro__img" />
          <img src="/intro/mid.png" alt="" class="intro__img" />
          <img src="/intro/3.png" alt="" class="intro__img" />
          <img src="/intro/4.png" alt="" class="intro__img" />
          <img src="/intro/5.png" alt="" class="intro__img" />
          <img src="/intro/6.png" alt="" class="intro__img" />
          <img src="/intro/final.png" alt="" class="intro__final" />
        </div>
      )
    }

    <div class="shell">
      <aside class="rail" aria-label="Site identity">
        <div class="rail__mark">
          <Wordmark />
        </div>
        <a
          class="rail__ig"
          href="https://instagram.com/jonas.morgner"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram (opens in new tab)"
        >
          BER
        </a>
      </aside>

      <main class="content" id="main">
        <header class="content__head">
          <Nav current={current} />
        </header>
        <div class="content__body">
          <slot />
        </div>
      </main>
    </div>

    <style>
      .shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: var(--rail-w) 1fr;
      }

      .rail {
        position: sticky;
        top: 0;
        align-self: start;
        height: 100vh;
        border-right: 1px solid var(--rail-divider);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(2rem, 4vw, 3rem);
      }

      .rail__mark {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .rail__ig {
        font-size: var(--fs-eyebrow);
        font-weight: 500;
        letter-spacing: 0.08em;
        color: var(--ink-muted);
        text-decoration: none;
        text-transform: uppercase;
      }
      .rail__ig:hover {
        color: var(--ink);
        opacity: 1;
      }

      .content {
        padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 5vw, 5rem)
          clamp(2.5rem, 6vw, 5rem);
        position: relative;
      }

      .content__head {
        position: absolute;
        top: clamp(1rem, 3vw, 2rem);
        right: clamp(1rem, 3vw, 2rem);
      }

      .content__body {
        max-width: var(--gallery-max);
      }

      .intro {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: var(--bg);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 1;
        transition: opacity 500ms cubic-bezier(0.4, 0, 0.2, 1);
      }
      .intro.is-hidden {
        opacity: 0;
        pointer-events: none;
      }
      .intro__img {
        position: absolute;
        max-width: min(30vw, 230px);
        max-height: min(35vh, 260px);
        width: auto;
        height: auto;
        opacity: 0;
        object-fit: contain;
      }
      .intro__img.is-active {
        opacity: 1;
      }

      .intro__final {
        position: absolute;
        max-width: min(30vw, 230px);
        max-height: min(35vh, 260px);
        width: auto;
        height: auto;
        object-fit: contain;
        opacity: 0;
      }
      .intro__final.is-active {
        opacity: 1;
      }

      @media (prefers-reduced-motion: reduce) {
        .intro {
          display: none;
        }
      }
    </style>

    <script is:inline>
      (function () {
        var overlay = document.getElementById('intro');
        if (!overlay) return;

        var remove = function () {
          if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
        };

        if (
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          remove();
          return;
        }

        var imgs = overlay.querySelectorAll('.intro__img');
        var finalImg = overlay.querySelector('.intro__final');
        var stepMs = Math.floor(1600 / imgs.length);
        var dwellMs = Math.round(650 * 1.1);
        var fadeMs = 500;
        var i = 0;

        var tick = setInterval(function () {
          imgs[i].classList.remove('is-active');
          i += 1;
          if (i >= imgs.length) {
            clearInterval(tick);
            if (finalImg) finalImg.classList.add('is-active');
            setTimeout(function () {
              overlay.classList.add('is-hidden');
              setTimeout(remove, fadeMs);
            }, dwellMs);
          } else {
            imgs[i].classList.add('is-active');
          }
        }, stepMs);
      })();
    </script>

    <script>
      /**
       * Peace-hand cursor on artwork images only.
       * Recolors from a black mask on every fresh hover.
       */
      const COLORS = [
        '#e74c3c',
        '#e67e22',
        '#f1c40f',
        '#2ecc71',
        '#1abc9c',
        '#3498db',
        '#9b59b6',
        '#ff6b9d',
        '#00bcd4',
        '#8bc34a',
      ];

      let mask: HTMLImageElement | null = null;
      let maskReady: Promise<HTMLImageElement> | null = null;
      let lastColor = '';
      let cache: { color: string; url: string; hotspotX: number; hotspotY: number } | null =
        null;

      function loadMask() {
        if (maskReady) return maskReady;
        maskReady = new Promise((resolve, reject) => {
          const img = new Image();
          img.onload = () => {
            mask = img;
            resolve(img);
          };
          img.onerror = reject;
          img.src = '/cursors/peace-mask.png';
        });
        return maskReady;
      }

      function nextColor() {
        let color = COLORS[Math.floor(Math.random() * COLORS.length)];
        if (COLORS.length > 1) {
          while (color === lastColor) {
            color = COLORS[Math.floor(Math.random() * COLORS.length)];
          }
        }
        lastColor = color;
        return color;
      }

      function hexToRgb(hex: string) {
        const n = parseInt(hex.slice(1), 16);
        return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };
      }

      async function cursorFor(color: string) {
        if (cache && cache.color === color) return cache;
        const img = await loadMask();
        const canvas = document.createElement('canvas');
        canvas.width = img.naturalWidth;
        canvas.height = img.naturalHeight;
        const ctx = canvas.getContext('2d');
        if (!ctx) return null;
        ctx.drawImage(img, 0, 0);
        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const { r, g, b } = hexToRgb(color);
        const d = imageData.data;
        for (let i = 0; i < d.length; i += 4) {
          if (d[i + 3] > 0) {
            d[i] = r;
            d[i + 1] = g;
            d[i + 2] = b;
          }
        }
        ctx.putImageData(imageData, 0, 0);
        const url = canvas.toDataURL('image/png');
        // Hotspot near the tip of the raised fingers.
        const hotspotX = Math.round(canvas.width * 0.42);
        const hotspotY = 2;
        cache = { color, url, hotspotX, hotspotY };
        return cache;
      }

      function bind(el: HTMLElement) {
        if (el.dataset.peaceBound) return;
        el.dataset.peaceBound = '1';

        el.addEventListener('mouseenter', async () => {
          if (!window.matchMedia('(pointer: fine)').matches) return;
          const cursor = await cursorFor(nextColor());
          if (!cursor) return;
          el.style.cursor = `url(${cursor.url}) ${cursor.hotspotX} ${cursor.hotspotY}, pointer`;
        });

        el.addEventListener('mouseleave', () => {
          el.style.cursor = '';
        });
      }

      function init() {
        void loadMask();
        document.querySelectorAll<HTMLElement>('[data-peace-cursor]').forEach(bind);
      }

      init();
      document.addEventListener('astro:page-load', init);
    </script>

    <Analytics />
    <SpeedInsights />
  </body>
</html>
