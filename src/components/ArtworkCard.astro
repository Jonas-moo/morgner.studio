---
import type { CollectionEntry } from 'astro:content';

interface Props {
  artwork: CollectionEntry<'artworks'>;
}

const { artwork } = Astro.props;
const { title, year, image, sold } = artwork.data;
---

<a href={`/work/${artwork.slug}`} class="card is-clean">
  <div class="card__thumb">
    <img src={image} alt={title} loading="lazy" />
  </div>
  <div class="card__meta">
    <p class="card__title">
      <span class="card__name">{title}</span>
      <span class="card__year">
        &mdash; {year}
        {sold && <span class="sold-dot" role="img" aria-label="Sold" />}
      </span>
    </p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    color: var(--ink);
    width: 100%;
  }

  .card__thumb {
    width: 100%;
    height: var(--card-image-height, clamp(240px, 32vw, 360px));
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    margin-bottom: 0.85rem;
    transition: opacity 160ms ease;
  }

  .card__thumb img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
  }

  .card__thumb:hover {
    opacity: 0.85;
  }

  .card__meta {
    text-align: left;
    line-height: 1.55;
  }

  .card__title {
    font-size: var(--fs-tile-label);
    font-weight: 500;
    margin: 0;
    color: var(--ink-muted);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4em;
  }

  .card__name {
    background: var(--ink);
    color: var(--bg);
    padding: 0.15em 0.45em;
    line-height: 1.3;
  }

  .card__year {
    color: var(--ink-muted);
  }

  .sold-dot {
    display: inline-block;
    width: 0.3em;
    height: 0.3em;
    margin-left: 0.35em;
    border-radius: 50%;
    background: #c0392b;
    vertical-align: middle;
  }
</style>
