---
import type { CollectionEntry } from 'astro:content';

interface Props {
  artwork: CollectionEntry<'artworks'>;
}

const { artwork } = Astro.props;
const { title, image, sold, dimensions } = artwork.data;
---

<a href={`/work/${artwork.slug}`} class="card is-clean">
  <div class="card__thumb">
    <img src={image} alt={title} loading="lazy" />
  </div>
  <div class="card__meta">
    <p class="card__title">
      <span class="card__name">{title}</span>
      <span class="card__dimensions" aria-hidden="true">
        &mdash; {dimensions}
      </span>
      {sold && <span class="sold-dot" role="img" aria-label="Sold" />}
    </p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    color: var(--ink);
    width: fit-content;
    max-width: 100%;
  }

  .card__thumb {
    height: var(--card-image-height, clamp(240px, 32vw, 360px));
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    margin-bottom: 0.85rem;
  }

  .card__thumb img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
  }

  .card__meta {
    text-align: left;
    line-height: 1.55;
  }

  .card__title {
    font-size: var(--fs-tile-label);
    font-weight: 500;
    margin: 0;
    color: var(--ink-muted);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4em;
  }

  .card__name {
    background: transparent;
    color: var(--ink);
    padding: 0.15em 0.45em;
    line-height: 1.3;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .card:hover .card__name,
  .card:focus-visible .card__name {
    background: var(--ink);
    color: var(--bg);
  }

  .card__dimensions {
    color: var(--ink-muted);
    font-style: italic;
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .card:hover .card__dimensions,
  .card:focus-visible .card__dimensions {
    opacity: 1;
  }

  .sold-dot {
    display: inline-block;
    width: 0.45em;
    height: 0.45em;
    margin-left: auto;
    border-radius: 50%;
    background: #c0392b;
    align-self: center;
    transform: translateY(0.15em);
    transition: opacity 160ms ease;
  }

  .card:hover .sold-dot,
  .card:focus-visible .sold-dot {
    opacity: 0;
  }
</style>
