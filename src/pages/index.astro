---
import Shell from '../layouts/Shell.astro';
---

<Shell title="Jonas C. Morgner" current="about" intro>
  <p class="eyebrow about-eyebrow">About</p>

  <h1 class="h1">
    Painting lets me stay close to the version of myself that feels most true.
  </h1>

  <div class="about-grid">
    <figure class="about-portrait">
      <img src="/about/portrait.png" alt="Portrait of Jonas C. Morgner" />
    </figure>

    <div class="prose">
      <p>
        Jonas C. Morgner (b. 2001, K&uuml;rten) is a Berlin-based painter
        working with acrylic on canvas.
      </p>
      <p>
        His abstract paintings are playful, intuitive, and layered &mdash;
        guided by color, curiosity, and a desire to reconnect with his
        authentic self. Working spontaneously and in the moment, Morgner
        treats painting as a way of becoming more honest, present, and
        instinctive.
      </p>
    </div>
  </div>

  <hr class="rule" />

  <dl class="meta">
    <div class="meta__cell">
      <dt>Studio</dt>
      <dd>Berlin, GER</dd>
    </div>
  </dl>
</Shell>

<style>
  .about-eyebrow {
    margin-bottom: var(--s-6);
  }

  .h1 {
    max-width: 640px;
    margin-bottom: var(--s-4);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(110px, 160px) minmax(0, 1fr);
    gap: var(--s-6);
    align-items: start;
    max-width: var(--gallery-max);
  }

  .prose {
    min-width: 0;
    max-width: var(--content-max);
  }

  .about-portrait {
    margin: 0;
  }
  .about-portrait img {
    width: 100%;
    height: auto;
    display: block;
  }

  .meta {
    margin: 0;
    max-width: var(--content-max);
  }
  .meta__cell {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .meta dt {
    font-size: var(--fs-eyebrow);
    color: var(--ink-muted);
    font-weight: 400;
  }
  .meta dd {
    margin: 0;
    font-size: var(--fs-nav);
    font-weight: 500;
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
    .about-portrait {
      max-width: 280px;
    }
  }
</style>
