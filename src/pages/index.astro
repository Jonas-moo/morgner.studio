---
import { getCollection } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import ArtworkCard from '../components/ArtworkCard.astro';

const artworks = (await getCollection('artworks')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Shell title="Jonas C. Morgner — Gallery" current="gallery">
  <p class="eyebrow gallery-eyebrow">Gallery</p>

  <ul class="grid">
    {
      artworks.map((artwork) => (
        <li class="grid__item">
          <ArtworkCard artwork={artwork} />
        </li>
      ))
    }
  </ul>
</Shell>

<style>
  .gallery-eyebrow {
    margin-bottom: var(--s-6);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4rem 2.5rem;
    max-width: var(--gallery-max);
  }

  .grid__item {
    margin: 0;
  }

  @media (max-width: 540px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
